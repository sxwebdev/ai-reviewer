# Copy to .env NEXT TO THIS FILE — compose reads `.env` from the directory the
# compose file lives in, not from where you run the command:
#
#   cp .env.example .env
#
# Everything else — teams, repositories, schedules, thresholds — lives in
# config.yaml. Only credentials belong here.

# GitLab personal access token of the service account, scope `api`.
AI_REVIEWER_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional Linear personal API key for teams with `linear_team_ids`.
# AI_REVIEWER_LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# Slack bot token (xoxb-…) with chat:write and users:read + users:read.email.
AI_REVIEWER_SLACK_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Claude Code OAuth token: run `claude setup-token` on a machine where you are
# logged in, and paste the result. A container has no host keychain to inherit,
# so the `existing-login` auth mode cannot be used here.
AI_REVIEWER_CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxx

# The database password compose creates PostgreSQL with, and the service then
# connects with. Any value, as long as both sides see the same one.
AI_REVIEWER_POSTGRES_PASSWORD=change-me

# Optional overrides; the compose file defaults both to `ai_reviewer`.
# AI_REVIEWER_POSTGRES_USERNAME=ai_reviewer
# AI_REVIEWER_POSTGRES_DATABASE=ai_reviewer
